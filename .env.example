# Solana RPC endpoint (server-side, required)
# Use a public endpoint or your own (Helius, QuickNode, etc.)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana RPC endpoint (client-side, for wallet adapter)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Helius API key (optional, enables enriched tx parsing + NFT detection)
HELIUS_API_KEY=

# Database URL — PostgreSQL (Neon free tier recommended for Vercel)
# Get one at: https://neon.tech (free, no credit card)
# For local dev with SQLite: change prisma/schema.prisma provider to "sqlite"
#   and use: DATABASE_URL=file:./dev.db
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Cron secret for leaderboard refresh endpoint
CRON_SECRET=change-me-in-production

# Base URL for OG image generation
NEXT_PUBLIC_BASE_URL=http://localhost:3000
